  "quiz_schema": {
    "description": "Blok ```json``` dengan `set_id`+`items` berisi satu set kuis.",
    "fields": {
      "set_id": "string unik",
      "level": "mudah | sedang | sulit | hots | tka",
      "time_limit_min": "number (opsional, khusus simulasi)",
      "items": [
        {
          "id": "string unik dalam set",
          "type": "short | mc | multi | proof",
          "competency": "K1..K6 (opsional)",
          "source": "referensi TKA (opsional)",
          "question": "string berisi KaTeX",
          "options": "array (khusus mc/multi)",
          "answer": "string (short/mc/proof) atau array (multi)",
          "explanation": "string pembahasan singkat"
        }
      ]
    }
  },
  "interaction_schema": {
    "description": "Blok ```json``` dengan `type`:`activity` = micro-interaksi di tengah materi; `type`:`challenge` = Tantangan Akhir Bab (asesmen akhir bab). Parser membedakan berdasarkan field `type` (activity/challenge) vs kehadiran `set_id` (quiz).",
    "placement_principle": "Learning beat: sisipkan 1 aktivitas 30-60 detik setiap 1-2 konsep; jangan >2 layar scroll tanpa interaksi. 1 Tantangan Akhir Bab per bab.",
    "activity_widgets": {
      "matching": { "prompt": "string", "pairs": "[[kiri, kanan], ...] (>=2)", "reward": "{xp}" },
      "categorize": { "prompt": "string", "categories": "[nama, ...] (>=2)", "items": "[[teks(KaTeX), kategori], ...]", "reward": "{xp}" },
      "ordering": { "prompt": "string", "options": "[teks, ...]", "answer_order": "permutasi indeks urutan benar; engine mengacak tampilan", "reward": "{xp}" },
      "cloze": { "prompt": "string", "template": "teks dengan placeholder {{0}} {{1}} ...", "answers": "[jawaban per blank sesuai indeks]", "reward": "{xp}" },
      "truefalse": { "prompt": "string", "statements": "[{s:teks, a:boolean, why:string}, ...]", "reward": "{xp}" },
      "error-hunt": { "prompt": "string", "steps": "[langkah, ...]", "wrong_index": "int (langkah yang salah)", "why": "string", "reward": "{xp}" },
      "horner-steps": { "note": "DIPAKAI DI BAB 03. Tabel Horner interaktif divalidasi sel-demi-sel.", "poly": "[koefisien tinggi->rendah]", "k": "number", "expected_quotient": "[koefisien hasil bagi, tinggi->rendah]", "expected_remainder": "number", "reward": "{xp}" },
      "slider": { "note": "DIPAKAI DI BAB 02. Slider x -> hitung f(x) real-time + grafik.", "poly": "[koefisien tinggi->rendah]", "x_min": "number", "x_max": "number", "step": "number (langkah slider)", "show_graph": "boolean", "checkpoints": "[{x, fx, note}] titik periksa opsional", "reward": "{xp}" }
    },
    "challenge_fields": {
      "id": "string unik", "title": "string", "competency": "K1..K6",
      "mode": "timed | untimed", "time_limit_sec": "number",
      "shuffle": "boolean",
      "pool": "[id aktivitas / set_id kuis / id item] yang ditarik ke Tantangan Akhir Bab",
      "scoring": "{per_correct:number, time_bonus:boolean}",
      "stars": "{\"3\": ambangSkor, \"2\": ..., \"1\": ...}",
      "reward": "{xp:number, badge:string}",
      "record": "{track_best_time:boolean, track_best_score:boolean}"
    }
  },
  "gamification": {
    "description": "Engine reward di aplikasi (bukan di .md). Semua status di localStorage.",
    "xp": {
      "source": "field `reward.xp` pada activity & challenge; kuis biasa juga boleh memberi xp (mis. 5/benar).",
      "levels": [
        { "level": 1, "min_xp": 0, "title": "Pemula" },
        { "level": 2, "min_xp": 150, "title": "Penjelajah" },
        { "level": 3, "min_xp": 400, "title": "Penguasa Muda" },
        { "level": 4, "min_xp": 800, "title": "Ahli" },
        { "level": 5, "min_xp": 1400, "title": "Master Polinomial" }
      ]
    },
    "badges": [
      { "id": "pengenal-polinomial", "competency": "K1", "chapter": "01", "unlock": "selesaikan Tantangan Akhir Bab 01" },
      { "id": "operator-polinomial", "competency": "K2", "chapter": "02", "unlock": "selesaikan Tantangan Akhir Bab 02" },
      { "id": "pembagi-ulung", "competency": "K3", "chapter": "03", "unlock": "selesaikan Tantangan Akhir Bab 03" },
      { "id": "ahli-teorema", "competency": "K4", "chapter": "04", "unlock": "selesaikan Tantangan Akhir Bab 04" },
      { "id": "penakluk-vieta", "competency": "K5", "chapter": "05", "unlock": "selesaikan Tantangan Akhir Bab 05" },
      { "id": "ahli-strategi", "competency": "K6", "chapter": "06", "unlock": "selesaikan Tantangan Akhir Bab 06" },
      { "id": "master-polinomial", "competency": "ALL", "unlock": "selesaikan simulasi TKA (bab 07) dengan >=3 bintang" }
    ],
    "stars": { "description": "Bintang Tantangan Akhir Bab dari ambang skor pada field `stars`; simpan bintang tertinggi." },
    "records": { "description": "Simpan capaian waktu & skor terbaik per Tantangan Akhir Bab sebagai umpan balik kemajuan.", "storage_keys": "poli.v1.record.<challengeId>" },
    "streak": { "description": "Streak belajar harian (opsional).", "storage_keys": "poli.v1.streak" },
    "competition_note": "Tanpa backend. Kompetisi antar teman terjadi lewat pembandingan bintang/waktu/level secara lokal (rekor pribadi). (Fitur share-code & class-seed TIDAK diaktifkan pada versi ini.)"
  }
